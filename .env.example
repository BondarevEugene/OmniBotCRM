# For Neon replace DATABASE_URL with postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# For HTTPS deployment set COOKIE_SECURE=true
# Generate CRM_ENCRYPTION_KEY once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep that key permanently; losing it makes saved bot and marketing secrets unreadable.
